# ================= DATABASE =================
# Primary database: PostgreSQL (Production) or SQLite (Local Dev Fallback)
# When DATABASE_URL is unset, Anshora automatically falls back to SQLite at data/anshora.db.
# PostgreSQL format: postgresql+psycopg2://user:password@localhost:5432/anshora
DATABASE_URL=

# ================= LLM =================
# Leave LLM_API_KEY empty to run in DEMO mode (offline brain, everything else works).
# Any OpenAI-compatible API works (OpenRouter, OpenAI, Azure, Together, Ollama, vLLM...).
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
# optional: tried if the main model fails (OpenRouter fallback list)
LLM_FALLBACK_MODEL=
# auto = native tool calling, falls back to JSON protocol if the model has no tool support
TOOL_MODE=auto
AGENT_MAX_STEPS=6
# auto | openai | mock   (mock = force demo mode)
LLM_PROVIDER=auto

# ================= AUTHENTICATION & JWT =================
# AUTH_REQUIRED=false skips the login screen (single-user local mode)
AUTH_REQUIRED=true
ALLOW_REGISTRATION=true
# JWT_SECRET is auto-generated into data/.jwt_secret if empty. Set it explicitly in production.
JWT_SECRET=
TOKEN_TTL_HOURS=72

# ================= GOOGLE SIGN-IN (USER AUTH) =================
# Dedicated Google OAuth credentials for Google Sign-In (openid, email, profile).
# If GOOGLE_SIGNIN_CLIENT_ID is unset, it falls back to GOOGLE_CLIENT_ID.
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
GOOGLE_SIGNIN_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ================= GMAIL DELIVERY OAUTH (REPORT SENDING) =================
# Dedicated OAuth credentials for sending verified reports from anshora.ai.agent@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback

GMAIL_SENDER_EMAIL=anshora.ai.agent@gmail.com
GMAIL_SENDER_NAME=Anshora AI Agent

# ================= APP & NETWORKING =================
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_CURRENCY=₹
MAX_UPLOAD_MB=200

# ================= TOOLS =================
# Python analysis tool runs LLM-written code in a restricted subprocess.
# For multi-tenant production run the backend inside a locked-down container or set this to false.
ENABLE_PYTHON_SANDBOX=true
SANDBOX_TIMEOUT=20

# ================= MONITORS / ALERTS =================
ENABLE_SCHEDULER=true
MONITOR_TICK_SECONDS=30
# SMTP for email alerts (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
